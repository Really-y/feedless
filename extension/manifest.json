{
  "manifest_version": 3,
  "name": "Feedless",
  "version": "1.4.0",
  "description": "Messages only on Instagram and TikTok. Blocks Reels, For You, Explore and the feed.",
  "homepage_url": "https://github.com/Really-y/feedless",
  "browser_specific_settings": {
    "gecko": {
      "id": "feedless@azedev.com",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Feedless",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.tiktok.com/*"],
      "js": ["quota.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
